        ],
        [
          "dʒ",
          "ʤ"
        ],
        [
          "tʃ",
          "ʧ"
        ],
        [
          "ɝ",
          "ɜɹ"
        ],
        [
          "ɫ",
          "l"
        ]
      ],
      "stress_before_vowel": true
    },
    {
      "name": "misaki-espeak",
      "languages": [],
      "match": {
        "vocab_has_all": [
          "A",
          "I",
          "O",
          "W",
          "Y"
        ]
      },
      "replace": [
        [
          "dʒ",
          "ʤ"
        ],
        [
          "tʃ",
          "ʧ"
        ],
        [
          "tɕ",
          "ʨ"
        ],
        [
          "dʑ",
