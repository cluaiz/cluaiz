  "sets": [
    {
      "name": "misaki",
      "languages": [
        "en"
      ],
      "match": {
        "vocab_has_all": [
          "A",
          "I",
          "O",
          "W",
          "Y"
        ]
      },
      "replace": [
        [
          "eɪ",
          "A"
