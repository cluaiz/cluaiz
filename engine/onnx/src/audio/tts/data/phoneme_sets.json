        ]
      ],
      "stress_before_vowel": false
    },
    {
      "name": "espeak",
      "languages": [],
      "match": {
        "config_phoneme_type": "espeak"
      },
      "replace": [
        [
          "ɝ",
          "ɜː"
        ],
        [
