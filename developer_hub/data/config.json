{
  "group": "Component Configuration",
  "endpoints": [
    {
      "method": "GET",
      "path": "/api/components/list",
      "desc": "Discovers all installed components (plugins, skills, and MCP servers) with their active security modes and token costs.",
      "docs_url": "/docs/reference/api.md",
      "params": [],
      "response": "{\n  \"plugin\": [\"web-scraper\"],\n  \"skill\": [\"code-review\"],\n  \"mcp\": [\"sqlite_mcp\"],\n  \"rich\": {}\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X GET http://localhost:8000/api/components/list"
        }
      ]
    },
    {
      "method": "GET",
      "path": "/api/components/settings",
      "desc": "Reads configuration settings for a component directly from ToolsRegistry.",
      "docs_url": "/docs/reference/api.md",
      "params": [
        {
          "name": "component_type",
          "type": "string",
          "req": true,
          "desc": "Component category ('plugin', 'skill', 'mcp').",
          "default": "plugin"
        },
        {
          "name": "component_id",
          "type": "string",
          "req": true,
          "desc": "Unique component identifier.",
          "default": "web-scraper"
        }
      ],
      "response": "{\n  \"status\": \"success\",\n  \"schema\": {},\n  \"values\": {\n    \"enabled\": true,\n    \"security_mode\": \"sandboxed\",\n    \"execution_mode\": \"auto\"\n  }\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X GET 'http://localhost:8000/api/components/settings?component_type=plugin&component_id=web-scraper'"
        }
      ]
    },
    {
      "method": "POST",
      "path": "/api/components/settings",
      "desc": "Updates configuration settings (enabled status, security mode) for a component in ToolsRegistry.",
      "docs_url": "/docs/reference/api.md",
      "params": [
        {
          "name": "component_id",
          "type": "string",
          "req": true,
          "desc": "The component identifier.",
          "default": "web-scraper"
        },
        {
          "name": "settings",
          "type": "object",
          "req": true,
          "desc": "Key-value map of settings to apply.",
          "default": {
            "enabled": true,
            "security_mode": "sandboxed"
          }
        }
      ],
      "request_payload": "{\n  \"component_id\": \"web-scraper\",\n  \"settings\": {\n    \"enabled\": true,\n    \"security_mode\": \"sandboxed\"\n  }\n}",
      "response": "{\n  \"status\": \"success\"\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X POST http://localhost:8000/api/components/settings \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"component_id\": \"web-scraper\", \"settings\": {\"enabled\": true}}'"
        }
      ]
    },
    {
      "method": "GET",
      "path": "/api/components/files",
      "desc": "Retrieves the complete directory file tree structure and cache footprint for a component.",
      "docs_url": "/docs/reference/api.md",
      "params": [
        {
          "name": "component_type",
          "type": "string",
          "req": true,
          "desc": "Component category ('plugin', 'skill', 'mcp').",
          "default": "plugin"
        },
        {
          "name": "component_id",
          "type": "string",
          "req": true,
          "desc": "Unique component identifier.",
          "default": "web-scraper"
        }
      ],
      "response": "{\n  \"files\": [\n    {\n      \"name\": \"package.json\",\n      \"path\": \"package.json\",\n      \"is_dir\": false\n    }\n  ],\n  \"temp_cache_size\": 0,\n  \"all_cache_size\": 0\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X GET 'http://localhost:8000/api/components/files?component_type=plugin&component_id=web-scraper'"
        }
      ]
    },
    {
      "method": "GET",
      "path": "/api/components/file",
      "desc": "Reads content and metadata of a specific file inside a component directory.",
      "docs_url": "/docs/reference/api.md",
      "params": [
        {
          "name": "component_type",
          "type": "string",
          "req": true,
          "desc": "Component category ('plugin', 'skill', 'mcp').",
          "default": "plugin"
        },
        {
          "name": "component_id",
          "type": "string",
          "req": true,
          "desc": "Unique component identifier.",
          "default": "web-scraper"
        },
        {
          "name": "file_path",
          "type": "string",
          "req": false,
          "desc": "Relative file path inside the component directory (defaults to package.json or SKILL.md).",
          "default": "package.json"
        }
      ],
      "response": "{\n  \"file_path\": \"package.json\",\n  \"content\": \"{\\n  \\\"name\\\": \\\"web-scraper\\\"\\n}\"\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X GET 'http://localhost:8000/api/components/file?component_type=plugin&component_id=web-scraper&file_path=package.json'"
        }
      ]
    },
    {
      "method": "POST",
      "path": "/api/components/file",
      "desc": "Updates or writes file contents for an installed component.",
      "docs_url": "/docs/reference/api.md",
      "params": [
        {
          "name": "component_type",
          "type": "string",
          "req": true,
          "desc": "Component category ('plugin', 'skill', 'mcp').",
          "default": "plugin"
        },
        {
          "name": "component_id",
          "type": "string",
          "req": true,
          "desc": "Unique component identifier.",
          "default": "web-scraper"
        },
        {
          "name": "content",
          "type": "string",
          "req": true,
          "desc": "Raw text content to write to the component file.",
          "default": "{\n  \"name\": \"web-scraper\",\n  \"version\": \"1.0.0\"\n}"
        }
      ],
      "request_payload": "{\n  \"component_type\": \"plugin\",\n  \"component_id\": \"web-scraper\",\n  \"content\": \"{\\n  \\\"name\\\": \\\"web-scraper\\\",\\n  \\\"version\\\": \\\"1.0.0\\\"\\n}\"\n}",
      "response": "{\n  \"status\": \"success\"\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X POST http://localhost:8000/api/components/file \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"component_type\": \"plugin\", \"component_id\": \"web-scraper\", \"content\": \"...\"}'"
        }
      ]
    },
    {
      "method": "POST",
      "path": "/api/components/cache",
      "desc": "Cleans and purges the internal .cache directory of an installed component.",
      "docs_url": "/docs/reference/api.md",
      "params": [
        {
          "name": "component_type",
          "type": "string",
          "req": true,
          "desc": "Component category ('plugin', 'skill', 'mcp').",
          "default": "plugin"
        },
        {
          "name": "component_id",
          "type": "string",
          "req": true,
          "desc": "Unique component identifier.",
          "default": "web-scraper"
        }
      ],
      "request_payload": "{\n  \"component_type\": \"plugin\",\n  \"component_id\": \"web-scraper\"\n}",
      "response": "{\n  \"status\": \"success\",\n  \"message\": \"Component cache cleared.\"\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X POST http://localhost:8000/api/components/cache \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"component_type\": \"plugin\", \"component_id\": \"web-scraper\"}'"
        }
      ]
    }
  ]
}
