    {
      "method": "POST",
      "path": "/v1/system/permission/approve",
      "desc": "Approves a paused tool invocation or sensitive filesystem operation by its request UUID.",
      "docs_url": "/docs/api/system/permission.md",
      "params": [
        {
          "name": "request_id",
          "type": "string",
          "req": true,
          "desc": "Unique UUID of the paused permission request.",
          "default": "7fa419ba-a5a4-441f-8e2b-ffad67a1496a"
        },
        {
          "name": "feedback",
          "type": "string",
          "req": false,
          "desc": "Optional annotation for approval audit log.",
          "default": "Approved by user in Developer Hub"
        }
      ],
      "request_payload": "{\n  \"request_id\": \"7fa419ba-a5a4-441f-8e2b-ffad67a1496a\",\n  \"feedback\": \"Approved by user in Developer Hub\"\n}",
      "response": "{\n  \"status\": \"success\",\n  \"message\": \"Permission approved\"\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X POST http://localhost:8000/v1/system/permission/approve \\\n  -H 'Authorization: Bearer sk-cluaiz-e46c11e877b20afb49c4df0fcfa44351' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"request_id\": \"7fa419ba-a5a4-441f-8e2b-ffad67a1496a\"}'"
        }
      ]
    },
