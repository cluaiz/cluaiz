      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X GET http://localhost:8000/health"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\nres = requests.get('http://localhost:8000/health')\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/health');\nconst data = await response.json();\nconsole.log(data);"
