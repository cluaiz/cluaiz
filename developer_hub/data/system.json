    {
      "method": "POST",
      "path": "/v1/system/permission",
      "desc": "Update engine security boundaries and sandboxing flags.",
      "docs_url": "/docs/api/system/permission.md",
      "params": [
        {
          "name": "key",
          "type": "string",
          "req": true,
          "desc": "The permission key to change.",
          "default": "wasm_firewall"
        },
        {
          "name": "value",
          "type": "string",
          "req": true,
          "desc": "The new value.",
          "default": "strict"
        }
      ],
      "request_payload": "{\n  \"wasm_firewall\": \"strict\",\n  \"vectorize_user_input\": true,\n  \"stream_telemetry\": false\n}",
      "response": "{\n  \"status\": \"success\",\n  \"updated_keys\": [\"wasm_firewall\", \"vectorize_user_input\"]\n}",
      "examples": [
        {
          "language": "curl",
          "title": "cURL",
          "code": "curl -X POST http://localhost:8000/v1/system/permission \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"wasm_firewall\": \"strict\", \"vectorize_user_input\": true, \"stream_telemetry\": false}'"
        },
        {
          "language": "python",
          "title": "Python",
          "code": "import requests\n\npayload = {\n    \"wasm_firewall\": \"strict\",\n    \"vectorize_user_input\": True,\n    \"stream_telemetry\": False\n}\nres = requests.post('http://localhost:8000/v1/system/permission', json=payload)\nprint(res.json())"
        },
        {
          "language": "javascript",
          "title": "Node.js",
          "code": "const response = await fetch('http://localhost:8000/v1/system/permission', {\n  method: 'POST',\n  headers: { 'Content-Type': 'application/json' },\n  body: JSON.stringify({\n    wasm_firewall: 'strict',\n    vectorize_user_input: true,\n    stream_telemetry: false\n  })\n});\nconst data = await response.json();\nconsole.log(data);"
        },
        {
          "language": "rust",
          "title": "Rust",
          "code": "let client = reqwest::Client::new();\nlet res = client.post(\"http://localhost:8000/v1/system/permission\")\n    .json(&serde_json::json!({\n        \"wasm_firewall\": \"strict\",\n        \"vectorize_user_input\": true,\n        \"stream_telemetry\": false\n    }))\n    .send()\n    .await?;\nprintln!(\"{:#?}\", res.json::<serde_json::Value>().await?);"
        }
      ]
    },
